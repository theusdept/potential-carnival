# Shopify public app (configure in the Shopify Dev Dashboard)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-returnguard-domain.example
SHOPIFY_APP_HANDLE=returnguard
SHOPIFY_APP_GID=gid://shopify/App/123456789
SHOPIFY_PARTNER_ORG_ID=
SHOPIFY_PARTNER_API_ACCESS_TOKEN=
SCOPES=read_orders

# PostgreSQL (Railway Postgres DATABASE_URL reference)
DATABASE_URL=postgresql://username:password@localhost:5432/returnguard

# Private S3-compatible object storage. Never expose this bucket publicly.
S3_ENDPOINT=https://your-s3-endpoint.example
S3_BUCKET=returnguard-private
S3_REGION=auto
S3_URL_STYLE=virtual
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Data export delivery and legal information
RESEND_API_KEY=
PRIVACY_FROM_EMAIL=privacy@yourdomain.example
LEGAL_OPERATOR_NAME=
SUPPORT_EMAIL=
PORT=3000
